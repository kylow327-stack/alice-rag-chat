# Primary provider (paid, extremely cheap — ~$0.0002 per answer)
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Secondary provider (free tier, 30 RPM / 1,000 RPD)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Fallback provider (free tier, 4-trio rotation)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Visit counter (free tier, 10,000 commands/day)
# Create an Upstash Redis database and link it via Vercel Marketplace:
# https://vercel.com/marketplace?category=storage&search=redis
# Vercel auto-injects these when you link the integration — no manual entry needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
